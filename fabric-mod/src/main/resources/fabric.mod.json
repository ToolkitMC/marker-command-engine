{
  "schemaVersion": 1,
  "id": "marker_command_engine",
  "version": "${version}",
  "name": "Marker Command Engine",
  "description": "Marker Command Engine datapack packaged as a Fabric mod with security hardening, Fabric API dependency, and Mod Menu integration.",
  "authors": [
    "runtoolkit",
    "Arena Agent security/fabric packaging"
  ],
  "contact": {
    "homepage": "https://github.com/runtoolkit/marker-command-engine",
    "issues": "https://github.com/runtoolkit/marker-command-engine/issues",
    "sources": "https://github.com/runtoolkit/marker-command-engine"
  },
  "license": "ARR",
  "icon": "assets/marker_command_engine/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.runtoolkit.mce.MarkerCommandEngineMod"
    ],
    "client": [
      "com.runtoolkit.mce.client.MarkerCommandEngineClient"
    ],
    "modmenu": [
      "com.runtoolkit.mce.client.MceModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.92.11",
    "minecraft": "~${minecraft_version}",
    "java": ">=17"
  },
  "recommends": {
    "modmenu": ">=${modmenu_version}"
  },
  "custom": {
    "modmenu": {
      "badges": [
        "library"
      ],
      "links": {
        "modmenu.fabric-api": "https://modrinth.com/mod/fabric-api",
        "modmenu.modmenu": "https://modrinth.com/mod/modmenu"
      }
    }
  }
}
